# Solana cluster configuration
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Program IDs
EXPO_PUBLIC_PLAYER_PROFILE_PROGRAM_ID=YOUR_PLAYER_PROFILE_PROGRAM_ID
EXPO_PUBLIC_SESSION_MANAGER_PROGRAM_ID=YOUR_SESSION_MANAGER_PROGRAM_ID
EXPO_PUBLIC_MAP_GENERATOR_PROGRAM_ID=YOUR_MAP_GENERATOR_PROGRAM_ID
EXPO_PUBLIC_GAMEPLAY_STATE_PROGRAM_ID=YOUR_GAMEPLAY_STATE_PROGRAM_ID
EXPO_PUBLIC_PLAYER_INVENTORY_PROGRAM_ID=YOUR_PLAYER_INVENTORY_PROGRAM_ID
EXPO_PUBLIC_POI_SYSTEM_PROGRAM_ID=YOUR_POI_SYSTEM_PROGRAM_ID
EXPO_PUBLIC_TREASURY_PUBKEY=YOUR_TREASURY_PUBKEY

