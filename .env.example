# Solana cluster configuration
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_EPHEMERAL_PROVIDER_ENDPOINT=https://devnet.magicblock.app/
EXPO_PUBLIC_EPHEMERAL_WS_ENDPOINT=wss://devnet.magicblock.app/
# Optional: endpoint that returns VRF randomness payloads (seed/value/randomness).
EXPO_PUBLIC_MAGICBLOCK_VRF_ENDPOINT=

# Program IDs
EXPO_PUBLIC_PLAYER_PROFILE_PROGRAM_ID=YOUR_PLAYER_PROFILE_PROGRAM_ID
EXPO_PUBLIC_SESSION_MANAGER_PROGRAM_ID=YOUR_SESSION_MANAGER_PROGRAM_ID
EXPO_PUBLIC_MAP_GENERATOR_PROGRAM_ID=YOUR_MAP_GENERATOR_PROGRAM_ID
EXPO_PUBLIC_GAMEPLAY_STATE_PROGRAM_ID=YOUR_GAMEPLAY_STATE_PROGRAM_ID
EXPO_PUBLIC_PLAYER_INVENTORY_PROGRAM_ID=YOUR_PLAYER_INVENTORY_PROGRAM_ID
EXPO_PUBLIC_POI_SYSTEM_PROGRAM_ID=YOUR_POI_SYSTEM_PROGRAM_ID
EXPO_PUBLIC_NFT_MARKETPLACE_PROGRAM_ID=YOUR_NFT_MARKETPLACE_PROGRAM_ID
EXPO_PUBLIC_TREASURY_PUBKEY=YOUR_TREASURY_PUBKEY

# Localnet example
# EXPO_PUBLIC_SOLANA_CLUSTER=devnet
# EXPO_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
# EXPO_PUBLIC_EPHEMERAL_PROVIDER_ENDPOINT=http://127.0.0.1:8899
# EXPO_PUBLIC_EPHEMERAL_WS_ENDPOINT=ws://127.0.0.1:8900
# EXPO_PUBLIC_PLAYER_PROFILE_PROGRAM_ID=LOCAL_PLAYER_PROFILE_PROGRAM_ID
# EXPO_PUBLIC_SESSION_MANAGER_PROGRAM_ID=LOCAL_SESSION_MANAGER_PROGRAM_ID
# EXPO_PUBLIC_MAP_GENERATOR_PROGRAM_ID=LOCAL_MAP_GENERATOR_PROGRAM_ID
# EXPO_PUBLIC_GAMEPLAY_STATE_PROGRAM_ID=YOUR_GAMEPLAY_STATE_PROGRAM_ID
# EXPO_PUBLIC_PLAYER_INVENTORY_PROGRAM_ID=YOUR_PLAYER_INVENTORY_PROGRAM_ID
# EXPO_PUBLIC_POI_SYSTEM_PROGRAM_ID=YOUR_POI_SYSTEM_PROGRAM_ID
# EXPO_PUBLIC_NFT_MARKETPLACE_PROGRAM_ID=YOUR_NFT_MARKETPLACE_PROGRAM_ID
# EXPO_PUBLIC_TREASURY_PUBKEY=YOUR_TREASURY_PUBKEY
