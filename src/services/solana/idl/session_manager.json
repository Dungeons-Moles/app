  "types": [
    {
      "name": "GameSession",
      "docs": [
        "Represents an active game session for a player.",
        "Campaign PDA seeds: [b\"session\", player.key(), &[campaign_level]]",
        "Duel/Gauntlet use dedicated prefixes to avoid collisions with campaign levels."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "player",
            "docs": [
              "Player profile owner's wallet"
            ],
            "type": "pubkey"
          },
          {
            "name": "session_id",
            "docs": [
              "Unique session identifier (incrementing)"
            ],
            "type": "u64"
          },
          {
            "name": "campaign_level",
            "docs": [
              "Level being played in this session (campaign mode, 1-40)"
            ],
            "type": "u8"
          },
          {
            "name": "started_at",
            "docs": [
              "Unix timestamp when session started"
            ],
            "type": "i64"
          },
          {
            "name": "last_activity",
            "docs": [
              "Unix timestamp of last activity"
            ],
            "type": "i64"
          },
          {
            "name": "is_delegated",
            "docs": [
              "Whether state is delegated to ephemeral rollup"
            ],
            "type": "bool"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          },
          {
            "name": "active_item_pool",
            "docs": [
              "Snapshot of player's active_item_pool at session start",
              "Determines which items can appear in POI offers during this session"
            ],
            "type": {
              "array": [
                "u8",
                10
              ]
            }
          },
          {
            "name": "burner_wallet",
            "docs": [
              "Burner wallet pubkey for gameplay transactions",
              "SOL is transferred to this wallet at session start"
            ],
            "type": "pubkey"
          },
          {
            "name": "state_hash",
            "docs": [
              "Hash of the current game state (for validation)"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          }
        ]
      }
    },
    {
      "name": "GameState",
      "docs": [
        "Core gameplay state account linked to a GameSession.",
        "Contains all mutable game data for a single run.",
        "Stats (ATK, ARM, SPD, DIG, MaxHP) are derived from inventory at runtime.",
        "PDA Seeds: [\"game_state\", session_pda.as_ref()]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "player",
            "docs": [
              "Session owner's main wallet (used for lifecycle operations like close)"
            ],
            "type": "pubkey"
          },
          {
            "name": "burner_wallet",
            "docs": [
              "Burner wallet authorized for gameplay transactions (move, boss fight)"
            ],
            "type": "pubkey"
          },
          {
            "name": "session",
            "docs": [
              "Linked GameSession PDA"
            ],
            "type": "pubkey"
          },
          {
            "name": "position_x",
            "docs": [
              "Current X coordinate (0 <= x < map_width)"
            ],
            "type": "u8"
          },
          {
            "name": "position_y",
            "docs": [
              "Current Y coordinate (0 <= y < map_height)"
            ],
            "type": "u8"
          },
          {
            "name": "map_width",
            "docs": [
              "Map boundary X (immutable after init)"
            ],
            "type": "u8"
          },
          {
            "name": "map_height",
            "docs": [
              "Map boundary Y (immutable after init)"
            ],
            "type": "u8"
          },
          {
            "name": "hp",
            "docs": [
              "Current health points (0 <= hp <= derived max_hp)"
            ],
            "type": "i16"
          },
          {
            "name": "gear_slots",
            "docs": [
              "Gear slot capacity (4 -> 6 -> 8 -> 10 -> 12)"
            ],
            "type": "u8"
          },
          {
            "name": "week",
            "docs": [
              "Current week (1-max_weeks)"
            ],
            "type": "u8"
          },
          {
            "name": "phase",
            "docs": [
              "Current time phase"
            ],
            "type": {
              "defined": {
                "name": "Phase"
              }
            }
          },
          {
            "name": "moves_remaining",
            "docs": [
              "Moves remaining in current phase (0-50)"
            ],
            "type": "u8"
          },
          {
            "name": "total_moves",
            "docs": [
              "Total moves made across session"
            ],
            "type": "u32"
          },
          {
            "name": "boss_fight_ready",
            "docs": [
              "Boss fight triggered flag"
            ],
            "type": "bool"
          },
          {
            "name": "gold",
            "docs": [
              "Current gold amount (0-65535)"
            ],
            "type": "u16"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          },
          {
            "name": "campaign_level",
            "docs": [
              "Campaign level for this session (1-40)",
              "Stored at init to prevent user manipulation of boss stage"
            ],
            "type": "u8"
          },
          {
            "name": "run_mode",
            "docs": [
              "Session mode controls week cap and weekly resolver."
            ],
            "type": {
              "defined": {
                "name": "RunMode"
              }
            }
          },
          {
            "name": "max_weeks",
            "docs": [
              "Maximum number of weeks for this run mode (3 campaign/duel, 5 gauntlet)."
            ],
            "type": "u8"
          },
          {
            "name": "is_dead",
            "docs": [
              "Player death flag - once set, all gameplay instructions are blocked"
            ],
            "type": "bool"
          },
          {
            "name": "completed",
            "docs": [
              "Level completion flag - set when week 3 boss is defeated",
              "Used by session_manager to validate end_session calls"
            ],
            "type": "bool"
          }
        ]
      }
    },
    {
      "name": "MapConfig",
      "docs": [
        "Configuration for map generation, storing seed values for each level."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "docs": [
              "Authority that can update seed mappings"
            ],
            "type": "pubkey"
          },
          {
            "name": "seeds",
            "docs": [
              "Seed values for campaign levels 1-40 (index = level - 1)"
            ],
            "type": {
              "array": [
                "u64",
                40
              ]
            }
          },
          {
            "name": "version",
            "docs": [
              "Config version for migrations"
