            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Phase",
      "docs": [
        "Time phase enumeration determining move allowance.",
        "Each day has 50 moves, each night has 30 moves."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Day1"
          },
          {
            "name": "Night1"
          },
