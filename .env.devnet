# Solana cluster configuration
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Ephemeral Rollup endpoints (devnet)
EXPO_PUBLIC_EPHEMERAL_PROVIDER_ENDPOINT=https://devnet.magicblock.app/
EXPO_PUBLIC_EPHEMERAL_WS_ENDPOINT=wss://devnet.magicblock.app/
EXPO_PUBLIC_USE_MAGIC_ROUTER=true
EXPO_PUBLIC_ROUTER_ENDPOINT=https://devnet-router.magicblock.app/
EXPO_PUBLIC_WS_ROUTER_ENDPOINT=wss://devnet-router.magicblock.app/
EXPO_PUBLIC_DELEGATION_REGION=auto
# Optional explicit validator override (takes precedence over region)
# EXPO_PUBLIC_DELEGATION_VALIDATOR=MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd

# Optional: VRF oracle queue account for request_*_vrf calls.
# Defaults to MagicBlock DEFAULT_QUEUE on devnet.
EXPO_PUBLIC_VRF_ORACLE_QUEUE=

# Jupiter API key (optional)
EXPO_PUBLIC_JUPITER_API_KEY=

# Sentry error tracking
EXPO_PUBLIC_SENTRY_DSN=

# Debug / logging
EXPO_PUBLIC_SHOW_DEV_WALLET=true
EXPO_PUBLIC_DISABLE_CONSOLE_LOGS=false
EXPO_PUBLIC_KEEP_CONSOLE_ERRORS=true

# Program IDs (must match your devnet deployments from ../solana-programs)
EXPO_PUBLIC_PLAYER_PROFILE_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_SESSION_MANAGER_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_MAP_GENERATOR_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_GAMEPLAY_STATE_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_PLAYER_INVENTORY_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_POI_SYSTEM_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_NFT_MARKETPLACE_PROGRAM_ID=<pubkey>
EXPO_PUBLIC_TREASURY_PUBKEY=<pubkey>
